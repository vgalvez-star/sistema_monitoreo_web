# Variables de entorno de referencia. Defínelas en tu servidor (en Render:
# Environment) o en tu terminal antes de iniciar la aplicación.

# --- Seguridad
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
ADMIN_USER=admin
ADMIN_PASSWORD=elige-una-contrasena-segura

# --- Monitoreo
# Sitios iniciales (solo se cargan si la base de datos está vacía)
MONITOR_SITES=https://www.google.com,https://www.github.com
# Segundos entre ciclos (mínimo 5)
CHECK_INTERVAL=15
# Segundos de espera antes de dar un sitio por caído
REQUEST_TIMEOUT=5
# Sobre este tiempo de respuesta el sitio se marca LENTO
SLOW_THRESHOLD_MS=1500
# Días de historial que se conservan
RETENTION_DAYS=7

# --- Base de datos
DB_PATH=monitor.db

# --- Detrás de un proxy HTTPS (Render, Nginx…)
TRUST_PROXY=0
SESSION_COOKIE_SECURE=0
